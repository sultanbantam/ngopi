{
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://app-cdn.minepi.com https://sdk.minepi.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.ngopi.top https://www.bamboochat.click https://bamboochat.click; connect-src 'self' blob: data: https://api.ngopi.top wss://api.ngopi.top https://bamboochain.id https://www.bamboochain.id https://api.minepi.com https://translate.googleapis.com https://api.mymemory.translated.net https://api.openai.com https://*.googleapis.com; media-src 'self' data: blob: https://api.ngopi.top; font-src 'self' data:; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/validation-key.txt",
      "destination": "/validation-key.txt"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterestbot|meta-externalagent|facebookcatalog).*"
        }
      ],
      "destination": "https://api.ngopi.top/api/og?path=/"
    },
    {
      "source": "/:profile([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterestbot|meta-externalagent|facebookcatalog).*"
        }
      ],
      "destination": "https://api.ngopi.top/api/og?path=/:profile"
    },
    {
      "source": "/chat/:profile",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterestbot|meta-externalagent|facebookcatalog).*"
        }
      ],
      "destination": "https://api.ngopi.top/api/og?path=/chat/:profile"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci"
}
