 6 files changed, 20 insertions(+), 20 deletions(-)

diff --git a/frontend/app.json b/frontend/app.json
index bb16eb0..1e0587c 100644
--- a/frontend/app.json
+++ b/frontend/app.json
@@ -1,9 +1,9 @@
 {
   "expo": {
-    "name": "frontend",
-    "slug": "frontend",
+    "name": "Ngopi",
+    "slug": "ngopi",
     "version": "1.0.0",
-    "scheme": "bamboochat",
+    "scheme": "ngopi",
