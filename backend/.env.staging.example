# NGOPINOMIC Staging Environment Template
# NEVER use production DATABASE_URL or production secrets here.

PORT=3100
NODE_ENV=staging
JWT_SECRET=replace-with-staging-32-byte-secret
ENCRYPTION_KEY=replace-with-staging-32-byte-key

# Isolated Staging PostgreSQL (must NOT point to production host)
DATABASE_URL="postgresql://ngopi_staging_user:REPLACE_PASSWORD@127.0.0.1:5439/ngopi_ngopinomic_staging?schema=public"

# Staging Mock Payment Gate (MUST remain false/unset in production)
NGOPINOMIC_ALLOW_MOCK_PAYMENT=true

# Frontend / CORS
FRONTEND_URL="http://localhost:8081"
CORS_ORIGINS="http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081"
PUBLIC_API_URL="http://127.0.0.1:3100"

