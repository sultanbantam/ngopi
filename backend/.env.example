# Environment Variables for BambooChat Backend

# Port for the Express server
PORT=3000

# Secret for JWT signing (Change this to a secure random string in production)
JWT_SECRET=supersecret_bamboochat_key_2026

# URL to your PostgreSQL database (Contabo VPS or elsewhere)
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/bamboochat?schema=public"

# URL of the frontend (for CORS setup)
FRONTEND_URL="http://localhost:19006" # Default Expo web port, change if needed

# Bamboochain RPC Settings
RPC_URL="https://rpc.bamboochain.example.com"
BMC_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
