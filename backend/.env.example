# Environment Variables for BambooChat Backend

# Port for the Express server
PORT=3000
NODE_ENV=development

# Generate strong secrets for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-random-32-byte-secret
ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-char-hex-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
MFA_ISSUER=BambooChat

# URL to your PostgreSQL database (Contabo VPS or elsewhere)
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bamboochat?schema=public"

# URL/origins allowed by CORS, comma-separated for multiple origins
FRONTEND_URL="http://localhost:19006"
CORS_ORIGINS="http://localhost:19006,http://localhost:8081,https://www.bamboochat.click,https://bamboochat.click"
PUBLIC_API_URL="https://api.bamboochat.click"
MAX_UPLOAD_BYTES=26214400

# BambooChain OAuth / RPC Settings
BAMBOOCHAIN_CLIENT_ID=replace-with-client-id
BAMBOOCHAIN_CLIENT_SECRET=replace-with-client-secret
BAMBOOCHAIN_REDIRECT_URI="https://api.bamboochat.click/api/auth/bamboochain/callback"
RPC_URL="https://rpc.bamboochain.example.com"
BMC_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"