generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  password_hash        String
  display_name         String
  role                 String    @default("user")
  mfa_secret_encrypted String?
  mfa_enabled          Boolean   @default(false)
  mfa_verified_at      DateTime?
  public_key           String?
  wallet_address       String?
  avatar_url           String?
  bio                  String?
  status               String?
  is_online            Boolean   @default(false)
  last_seen            DateTime  @default(now())
  created_at           DateTime  @default(now())
  bmc_id               Int       @default(autoincrement())

  messages            Message[]
  groupsCreated       Group[]          @relation("GroupCreator")
  groupMembers        GroupMember[]
  settings            UserSettings?
  airdropClaims       AirdropClaim[]
  platformAssignments Platform[]       @relation("PlatformSupportAgent")
  ticketsCreated      Ticket[]         @relation("TicketCreator")
  ticketsAssigned     Ticket[]         @relation("TicketAgent")
  ticketMessages      TicketMessage[]
  ticketAuditLogs     TicketAuditLog[]
  refreshTokens       RefreshToken[]
  gamePlayers         GamePlayer[]
}

model Message {
  id                String   @id @default(uuid())
  room_id           String // Bisa berupa kombinasi UserID (1-on-1) atau GroupID
  sender_id         String
  content           String? // Optional for non-text messages
  type              String   @default("text") // "text", "image", "audio", "document"
  attachment_url    String?
  is_delivered      Boolean  @default(false)
  is_read           Boolean  @default(false)
  timestamp         DateTime @default(now())
  reactions         Json? // Store reactions, e.g. {"sender_id": "emoji"}
  is_edited         Boolean  @default(false)
  is_pinned         Boolean  @default(false)
  is_deleted        Boolean  @default(false)
  deleted_for_all   Boolean  @default(false)
  parent_message_id String? // For reply/quote feature
  forwarded_from_id String? // Original message ID if forwarded

  sender  User      @relation(fields: [sender_id], references: [id])
  parent  Message?  @relation("MessageReplies", fields: [parent_message_id], references: [id])
  replies Message[] @relation("MessageReplies")
}

model Group {
  id                   String   @id @default(uuid())
  name                 String
  description          String?
  avatar_url           String?
  invite_code          String?  @unique
  join_policy          String   @default("open")
  only_admins_can_send Boolean  @default(false)
  allow_member_invites Boolean  @default(true)
  call_enabled         Boolean  @default(true)
  min_bmc_balance      Float    @default(0)
  theme                String?  @default("warkop_klasik")
  ambient_sound        String?
  created_by           String
  created_at           DateTime @default(now())

  creator User          @relation("GroupCreator", fields: [created_by], references: [id])
  members GroupMember[]
}

model GroupMember {
  id         String   @id @default(uuid())
  group_id   String
  user_id    String
  role       String   @default("member")
  status     String   @default("active")
  invited_by String?
  joined_at  DateTime @default(now())

  group Group @relation(fields: [group_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])

  @@unique([group_id, user_id])
}

model UserSettings {
  id                 String  @id @default(uuid())
  user_id            String  @unique
  hide_name          Boolean @default(false)
  hide_contacts      Boolean @default(false)
  hide_groups        Boolean @default(false)
  preferred_language String  @default("id")

  user User @relation(fields: [user_id], references: [id])
}

model AirdropClaim {
  id         String   @id @default(uuid())
  user_id    String
  amount     Float    @default(0.1)
  claimed_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, claimed_at])
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

model Platform {
  id               String   @id @default(uuid())
  name             String   @unique
  display_name     String
  description      String
  website_url      String
  icon             String?
  support_agent_id String?
  created_at       DateTime @default(now())

  support_agent User?    @relation("PlatformSupportAgent", fields: [support_agent_id], references: [id])
  faqs          Faq[]
  tickets       Ticket[]

  @@index([support_agent_id])
  @@map("platforms")
}

model Faq {
  id          String   @id @default(uuid())
  platform_id String
  question    String
  answer      String
  keywords    String[] @default([])
  created_at  DateTime @default(now())

  platform Platform @relation(fields: [platform_id], references: [id], onDelete: Cascade)

  @@unique([platform_id, question])
  @@index([platform_id])
  @@map("faqs")
}

model Ticket {
  id                String       @id @default(uuid())
  user_id           String
  platform_id       String
  title             String
  status            TicketStatus @default(open)
  assigned_agent_id String?
  is_escalated      Boolean      @default(false)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  user           User             @relation("TicketCreator", fields: [user_id], references: [id])
  platform       Platform         @relation(fields: [platform_id], references: [id])
  assigned_agent User?            @relation("TicketAgent", fields: [assigned_agent_id], references: [id])
  messages       TicketMessage[]
  auditLogs      TicketAuditLog[]

  @@index([user_id])
  @@index([platform_id])
  @@index([assigned_agent_id])
  @@index([status])
  @@map("tickets")
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticket_id   String
  sender_id   String
  content     String
  is_internal Boolean  @default(false)
  created_at  DateTime @default(now())

  ticket Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [sender_id], references: [id])

  @@index([ticket_id])
  @@index([sender_id])
  @@index([is_internal])
  @@map("ticket_messages")
}

model TicketAuditLog {
  id         String   @id @default(uuid())
  ticket_id  String
  actor_id   String
  action     String
  metadata   Json?
  created_at DateTime @default(now())

  ticket Ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actor_id], references: [id])

  @@index([ticket_id])
  @@index([actor_id])
  @@map("ticket_audit_logs")
}

model RefreshToken {
  id                   String    @id @default(uuid())
  user_id              String
  token_hash           String    @unique
  family_id            String
  expires_at           DateTime
  revoked_at           DateTime?
  replaced_by_token_id String?
  created_ip           String?
  user_agent           String?
  created_at           DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

// SPRINT 1: Jukebox Warung
model JukeboxTrack {
  id         String    @id @default(uuid())
  warung_id  String    @map("warung_id")
  track_uri  String    @map("track_uri")
  title      String
  artist     String
  thumbnail  String?
  duration   Int       @default(0) // detik
  added_by   String    @map("added_by")
  position   Int       @default(0)
  is_playing Boolean   @default(false)
  started_at DateTime?
  created_at DateTime  @default(now())

  @@index([warung_id])
  @@map("jukebox_tracks")
}

model JukeboxVote {
  id         String   @id @default(uuid())
  track_id   String   @map("track_id")
  user_id    String   @map("user_id")
  vote_type  String   @map("vote_type") // "skip" atau "like"
  created_at DateTime @default(now())

  @@unique([track_id, user_id, vote_type])
  @@map("jukebox_votes")
}

// SPRINT 2: Surat Kopi & Warkop Engagement
model CoffeeLetter {
  id            String    @id @default(uuid())
  sender_id     String    @map("sender_id")
  recipient_id  String    @map("recipient_id")
  content       String    // Terenkripsi
  scheduled_at  DateTime  @map("scheduled_at")
  delivery_mode String    @default("scheduled") // "scheduled", "when_online"
  delivered_at  DateTime?
  is_opened     Boolean   @default(false)
  created_at    DateTime  @default(now())

  @@index([recipient_id])
  @@index([scheduled_at])
  @@map("coffee_letters")
}

model WarungMute {
  id          String    @id @default(uuid())
  user_id     String    @map("user_id")
  warung_id   String    @map("warung_id")
  muted_until DateTime? @map("muted_until")
  created_at  DateTime  @default(now())

  @@unique([user_id, warung_id])
  @@map("warung_mutes")
}

model GuestbookEntry {
  id         String   @id @default(uuid())
  warung_id  String   @map("warung_id")
  user_id    String   @map("user_id")
  content    String   // Terenkripsi
  entry_type String   @default("quote") // "quote", "puisi", "gambar"
  created_at DateTime @default(now())

  @@index([warung_id])
  @@map("guestbook_entries")
}

model NgopiSchedule {
  id           String   @id @default(uuid())
  warung_id    String   @map("warung_id")
  title        String
  description  String?
  scheduled_at DateTime @map("scheduled_at")
  call_type    String   @default("voice") // "voice", "video"
  created_by   String   @map("created_by")
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  @@index([warung_id])
  @@map("ngopi_schedules")
}

// SPRINT 3: Gamifikasi & Profil Meja
model ChatStreak {
  id             String   @id @default(uuid())
  user_a_id      String   @map("user_a_id")
  user_b_id      String   @map("user_b_id")
  current_streak Int      @default(0)
  longest_streak Int      @default(0)
  last_chat_at   DateTime @default(now()) @map("last_chat_at")

  @@unique([user_a_id, user_b_id])
  @@map("chat_streaks")
}

model Badge {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  icon        String
  created_at  DateTime @default(now())

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(uuid())
  user_id    String   @map("user_id")
  badge_id   String   @map("badge_id")
  awarded_at DateTime @default(now())

  @@unique([user_id, badge_id])
  @@map("user_badges")
}

model ProfileTable {
  id             String   @id @default(uuid())
  user_id        String   @unique
  background     String?
  stickers       Json?
  quote          String?
  favorite_track String?
  updated_at     DateTime @updatedAt

  @@map("profile_tables")
}

// ==========================================
// MODUL PERMAINAN: "MEJA WARKOP" (Ngopi Games)
// ==========================================

// Meja Permainan (Table)
model GameTable {
  id          String    @id @default(uuid())
  warung_id   String?   @map("warung_id") // Bisa terikat ke Warung Kopi tertentu
  game_type   String    @map("game_type") // "gapleh", "remi", "bridge", "truf", "poker", "catur"
  name        String
  max_players Int       @map("max_players")
  min_players Int       @map("min_players")
  status      String    @default("waiting") // "waiting", "playing", "finished"
  is_private  Boolean   @default(false) @map("is_private")
  password    String?
  config      Json?
  host_id     String    @map("host_id")
  created_at  DateTime  @default(now()) @map("created_at")
  started_at  DateTime? @map("started_at")
  finished_at DateTime? @map("finished_at")

  players     GamePlayer[]
  spectators  GameSpectator[]
  game_state  GameState?

  @@map("game_tables")
}

// Pemain di Meja
model GamePlayer {
  id           String    @id @default(uuid())
  table_id     String    @map("table_id")
  user_id      String    @map("user_id")
  seat_number  Int       @map("seat_number")
  team         String?
  chip_balance Float     @default(0) @map("chip_balance")
  is_ready     Boolean   @default(false) @map("is_ready")
  is_active    Boolean   @default(true) @map("is_active")
  joined_at    DateTime  @default(now()) @map("joined_at")

  user         User      @relation(fields: [user_id], references: [id])
  table        GameTable @relation(fields: [table_id], references: [id], onDelete: Cascade)

  @@unique([table_id, seat_number])
  @@map("game_players")
}

// Penonton (Spectator)
model GameSpectator {
  id        String    @id @default(uuid())
  table_id  String    @map("table_id")
  user_id   String    @map("user_id")
  joined_at DateTime  @default(now()) @map("joined_at")

  table     GameTable @relation(fields: [table_id], references: [id], onDelete: Cascade)

  @@map("game_spectators")
}

// State Permainan
model GameState {
  id            String    @id @default(uuid())
  table_id      String    @unique @map("table_id")
  state_data    Json
  turn_player   String?   @map("turn_player")
  turn_deadline DateTime? @map("turn_deadline")
  round_number  Int       @default(1) @map("round_number")
  updated_at    DateTime  @updatedAt @map("updated_at")

  table         GameTable @relation(fields: [table_id], references: [id], onDelete: Cascade)

  @@map("game_states")
}

// Riwayat Pertandingan
model GameHistory {
  id           String   @id @default(uuid())
  table_id     String   @map("table_id")
  game_type    String   @default("gapleh") @map("game_type")
  winner_ids   String[] @map("winner_ids")
  loser_ids    String[] @map("loser_ids")
  score_data   Json     @map("score_data")
  duration_sec Int      @map("duration_sec")
  finished_at  DateTime @default(now()) @map("finished_at")

  @@map("game_histories")
}


